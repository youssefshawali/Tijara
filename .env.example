# Environment Configuration
# Copy to .env.local and fill in values

# Site URL (production)
NEXT_PUBLIC_SITE_URL=https://tijara.dev

# API URL (when backend is deployed)
NEXT_PUBLIC_API_URL=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Future backend secrets
# DATABASE_URL=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# CONTACT_EMAIL=hello@tijara.dev
