# Environment Configuration
# Copy to .env.local and fill in values

# Site URL (production)
NEXT_PUBLIC_SITE_URL=https://tijara.dev

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# PostgreSQL (pgAdmin 4)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/tijara

# NextAuth — REQUIRED
AUTH_SECRET=your-secret-here
AUTH_URL=http://localhost:3000

# Admin seed credentials (used by npm run seed)
ADMIN_EMAIL=admin@tijara.dev
ADMIN_PASSWORD=Admin@123456

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email notifications (contact form)
# Notifications go to Admin Settings email unless overridden below
CONTACT_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
